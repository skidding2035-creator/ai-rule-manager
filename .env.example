# Copy this file to .env and fill in your own Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# Leave VITE_USE_SUPABASE unset or "false" to keep running on local mock data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_USE_SUPABASE=false

# --- mcp-server only (never used by the browser app, never prefix with VITE_) ---
# Service_role key (Project Settings -> API -> Secret keys). Bypasses RLS —
# required once auth_migration.sql is applied. Keep this out of any client bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret the MCP HTTP server requires as a ?token= query param (or
# Authorization: Bearer header) once it's exposed publicly. Generate any
# random string, e.g. `openssl rand -hex 32`.
MCP_SHARED_SECRET=
